# Northwind Clearinghouse — daily claims file transfer settings
# Read by partner_transfer.py (KEY=VALUE, no shell expansion).

PARTNER_NAME=Northwind Clearinghouse
PARTNER_ACCOUNT=CRS-NWC-0042
# The reference estate's gateway speaks plain HTTP on port 443 (no TLS).
# Against the real partner this would be https://.
PARTNER_URL=http://partner-gw.northwind-clearing.test:443/v1/files
PARTNER_DEADLINE=06:00 America/New_York
PARTNER_TIMEOUT_SECONDS=30

FILE_PREFIX=claims_daily_
OUTBOUND_DIR=/var/spool/crs/outbound
BUSINESS_TIMEZONE=America/New_York

SERVICE_ACCOUNT=svc_rptxfer
